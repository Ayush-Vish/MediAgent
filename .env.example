ENVIRONMENT=local
LOG_FILE=runtime/logs/mediagent.jsonl
# Print approved retrieved source chunks in the local terminal (never cloud/file logs).
LOG_SHOW_CHUNKS=true
# Display user queries in the local console only.
LOG_SHOW_QUERY=true
DATABASE_URL=sqlite:///runtime/mediagent.db
HOSPITAL_NAME=CMC Vellore
HOSPITAL_ID=cmc-vellore
# Optional override. Other hospital deployments must supply their own portal link.
HOSPITAL_PORTAL_URL=
PUBLIC_URL=http://localhost:8000
# Set a long random token to enable local staff access. Never expose this publicly.
ADMIN_TOKEN=
# Cloud staff: sign in with Supabase; user app_metadata.role must be mediagent_staff.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Optional. Raw user messages and conversation history are never sent to Gemini.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_DAILY_LIMIT=100
# Use pool to combine all configured provider objects with automatic fallback.
# Provider strategy: pool, auto, gemini, openrouter, openai_compatible, or local.
AI_PROVIDER=auto
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://openrouter.ai/api/v1
AI_DAILY_LIMIT=100
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
GROQ_API_KEY=
GROQ_API_KEYS=
GROQ_MODEL=
# Comma-separated pools; plural settings override the corresponding single key.
OPENROUTER_API_KEYS=
GEMINI_API_KEYS=
AI_API_KEYS=
# Per-key requests per rolling 60 seconds and concurrent calls.
AI_POOL_RPM=60
AI_POOL_CONCURRENCY=2
# At most this many distinct keys attempted per model call; no waiting/sleeping.
AI_POOL_MAX_ATTEMPTS=3
# Set true when keys share an account/project quota: RPM, concurrency and 429
# cooldown then apply to the entire pool instead of rotating around that limit.
AI_POOL_SHARED_LIMITS=false
# Install requirements-rag.txt and index sources before enabling hybrid search.
QDRANT_URL=
QDRANT_PATH=
QDRANT_API_KEY=
QDRANT_COLLECTION=mediagent
HYBRID_ENABLED=false
RERANK_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CHANNEL_HASH_SECRET=
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=
RETENTION_HOURS=24
SOURCE_MAX_AGE_DAYS=90
